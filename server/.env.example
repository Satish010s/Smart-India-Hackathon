PORT=5001
NODE_ENV=development
# Neon PostgreSQL / Standard PostgreSQL connection string
DATABASE_URL="postgresql://<user>:<password>@<endpoint>-pooler.c-5.us-east-2.aws.neon.tech/neondb?sslmode=require"
AI_ENGINE_URL="http://localhost:8000"
CLIENT_URL="http://localhost:3000"

# JWT Secrets (replace with secure random 64+ char strings in production)
JWT_ACCESS_SECRET="your-super-secret-access-jwt-key"
JWT_REFRESH_SECRET="your-super-secret-refresh-jwt-key"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Resend Transactional Email API Key
RESEND_API_KEY="re_xxxxxxxxxxxx"
RESEND_FROM_EMAIL="Quantum Platform <onboarding@resend.dev>"

